{
  "name": "studyflow-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev -c wrangler.mock.jsonc",
    "dev:e2e": "rm -rf .wrangler/e2e && wrangler dev -c wrangler.mock.jsonc --port 8787 --persist-to .wrangler/e2e --var MOCK_AI:1 --var SESSION_SECRET:e2e-secret-e2e-secret-e2e-secret-00 --var ALLOWED_ORIGINS:http://localhost:5173",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "evals": "node evals/run.mjs"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.25",
    "@cloudflare/ai-chat": "0.12.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@studyflow/shared": "*",
    "agents": "0.27.0",
    "ai": "7.0.133",
    "workers-ai-provider": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@cloudflare/vitest-plugin": "1.3.7",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
